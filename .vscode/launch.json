{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Wails3: Debug Go Backend",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}",
            "cwd": "${workspaceFolder}",
            "args": [
                "dev"
            ]
        },
        {
            "type": "chrome",
            "name": "Launch Mac for webapp",
            "request": "launch",
            "runtimeArgs": [
                "--remote-debugging-port=9222"
            ],
            "url": "http://localhost:9245",
            "webRoot": "${workspaceFolder}/apps/frontend",
            "userDataDir": "/Users/muinas/code_space/chrome-debug-profile",
            "presentation": {
                "hidden": false
            }
        },
    ]
}